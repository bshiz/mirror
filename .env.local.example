# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# Fireflies — get from app.fireflies.ai/account > API
FIREFLIES_API_KEY=your_fireflies_api_key

# Webhook secret — generate a random string, paste into Fireflies webhook config
FIREFLIES_WEBHOOK_SECRET=your_webhook_secret

# App URL — localhost for dev, your Vercel URL for production
NEXT_PUBLIC_APP_URL=http://localhost:3000
